# Sweety Backend Environment Variables Example

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# JWT Secret Key for authenticating API requests
JWT_SECRET=sweety-super-secret-jwt-key-2026

# JWT Expiration
JWT_EXPIRES_IN=7d

# PostgreSQL Connection String
# Example: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sweety_db

# Redis Connection URL (Optional - falls back seamlessly to ioredis-mock if not running)
REDIS_URL=redis://localhost:6379

# Fallback mode: set to true to force in-memory PostgreSQL emulator (pg-mem)
# When false (default), the app connects to PostgreSQL and falls back gracefully if not reachable
USE_MEMORY_DB=false
